@article{keazorKulturelleKannibalenVideoclips2007,
	title = {„{Kulturelle} {Kannibalen}“? : {Videoclips} prägen inzwischen zunehmend {Erscheinungsbild} und Ästhetik unserer {Kunst}- und {Alltagskultur}},
	copyright = {All rights reserved},
	shorttitle = {"{Kulturelle} {Kannibalen}"?},
	url = {https://nbn-resolving.org/urn:nbn:de:hebis:30-46366},
	abstract = {Gute Musikvideoclips weisen bei aller Ästhetisierung zuweilen ein durchaus kritisches Potenzial auf: das 1993 von Regisseur Marcus Nispel zu George Michaels Stück »Killer/Papa was a rolling stone« gedrehte Video greift überwiegend auf Haushaltsartikel, deren Firmenlogos und Werbespots zurück, die uns aus dem Alltag bekannt sind, ersetzt die Namen der Artikel jedoch durch einzelne Worte, die dem Liedtext entstammen. So ergibt sich eine den Glücksversprechen der Konsumindustrie gegenüber provokante Aussage, denn die zu Logos und Produktnamen umfunktionierten Begriffe bezeichnen gerade menschliche Grunderfahrungen und Tugenden wie »Freiheit«, »Leben«, »Wahrheit« und »Sterben«, die somit als dem Ausverkauf anheim gegeben dargestellt werden.},
	language = {de-DE},
